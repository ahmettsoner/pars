@Library('shared-lib') _

pipeline {
    agent none

    parameters {
        string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
    }
    environment {
        APPNAME      = "pars"
    }

    stages {
        stage("Prepare workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values "linux", 'rhel', 'debian'
                    }
                }
                stages {
                    stage("Setup") {
                        agent { label PLATFORM }
                        steps {
                            script {
                                setupAgent(params.BRANCH)
                            }
                        }
                    }
                    stage("Docs") {
                        agent { label PLATFORM }
                        steps {
                            script {
                                generateDocs()
                            }
                        }
                    }
                    stage("Checksum") {
                        agent { label PLATFORM }
                        steps {
                            script {
                                generateChecksum()
                            }
                        }
                    }
                }
            }
        }




        stage('Build Binaries') {
            matrix {
                axes {
                    axis {
                        name 'OS'
                        values 'linux', 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64', 'arm64'
                    }
                }

                excludes {
                    exclude {
                        combination {
                            OS 'netbsd'
                            ARCH 'arm64'
                        }
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "linux" }
                        steps {
                            script {
                                buildBinary(OS, ARCH)
                                archiveBinary(OS, ARCH)
                                
                                def archExt = ""
                                if (OS == 'windows') {
                                    archExt = "zip"
                                } else {
                                    archExt = "tar.gz"
                                }
                                packageArtifact(OS, ARCH, archExt)
                            }
                        }
                    }
                }
            }
        }
        stage('Build Packages') {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'debian', 'rhel'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64', 'arm64'
                    }
                }
                stages {
                    stage('Archive and Package') {
                        agent { label PLATFORM }
                        steps {
                            script {
                                if (PLATFORM == 'rhel') {
                                    buildRPMPackage("linux", ARCH)
                                    copyRpmAndUpdateChecksums("linux", ARCH)
                                } else if (PLATFORM == 'debian') {
                                    buildDEBPackage("linux", ARCH)
                                    copyDebAndUpdateChecksums("linux", ARCH)
                                }
                            }
                        }
                    }
                }
            }
        }
    

        stage('Collect Artifacts') {
            matrix {
                axes {
                    axis {
                        name 'OS'
                        values 'linux', 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64', 'arm64'
                    }
                }

                excludes {
                    exclude {
                        combination {
                            OS 'netbsd'
                            ARCH 'arm64'
                        }
                    }
                }
                stages {
                    stage("Upload artifacts") {
                        agent { label 'linux' }
                        steps {
                            unstash "${OS}-${ARCH}-artifacts"
                            unstash "${OS}-${ARCH}-archive-artifacts"

                            script {
                                if (OS == 'linux') {
                                    unstash "${OS}-${ARCH}-rpm-package-artifacts"
                                    unstash "${OS}-${ARCH}-deb-package-artifacts"
                                }
                            }
                            archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                        }
                    }
                }
            }
        }

        stage("Clean workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'linux', 'rhel', 'debian'
                    }
                }
                stages {
                    stage("Delete dist files") {
                        agent { label PLATFORM }
                        steps {
                            script {
                                sh "rm -rf ${env.DIST_PATH}/*"
                            }
                        }
                    }
                }
            }
        }
    }
}
