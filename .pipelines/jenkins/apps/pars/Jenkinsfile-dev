@Library('shared-lib') _

pipeline {
    agent none

    parameters {
        string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
    }
    environment {
        APPNAME      = "pars"
    }

    stages {
        // stage("Prepare workspace") {
        //     matrix {
        //         axes {
        //             axis {
        //                 name 'PLATFORM'
        //                 values "linux", 'rhel', 'debian'
        //             }
        //         }
        //         stages {
        //             stage("Setup") {
        //                 agent { label PLATFORM }
        //                 steps {
        //                     script {
        //                         setupAgent(params.BRANCH)
        //                     }
        //                 }
        //             }
        //         }
        //     }
        // }
        stage("Common Operations") {
            parallel {
                stage("Docs") {
                    agent { label 'linux' }
                    steps {
                        script {
                            agentInitOnce.initOnce(params.BRANCH)
                        }
                        script {
                            generateDocs()
                        }
                    }
                    post {
                        always {
                            script {
                                agentInitOnce.cleanupOnce()
                            }
                        }
                    }
                }
                stage("Checksum") {
                    agent { label 'linux' }
                    steps {
                        script {
                            agentInitOnce.initOnce(params.BRANCH)
                            generateChecksum()
                        }
                    }
                    post {
                        always {
                            script {
                                agentInitOnce.cleanupOnce()
                            }
                        }
                    }
                }
            }
        }



        stage('Build Binaries') {
            matrix {
                axes {
                    axis {
                        name 'OS'
                        values 'linux', 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64', 'arm64'
                    }
                }
                excludes {
                    exclude {
                        axis {
                            name 'OS'
                            values 'netbsd'
                        }
                        axis {
                            name 'ARCH'
                            values 'arm64'
                        }
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "linux" }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                                buildBinary(OS, ARCH)
                                archiveBinary(OS, ARCH)
                                
                                def archExt = ""
                                if (OS == 'windows') {
                                    archExt = "zip"
                                } else {
                                    archExt = "tar.gz"
                                }
                                packageArtifact(OS, ARCH, archExt)
                            }
                        }
                        post {
                            always {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                    // stage("Package for Linux") {
                    //     when {
                    //         expression { return OS == 'linux' }
                    //     }
                    //     steps {
                    //         script {
                    //             parallel(
                    //                 "RPM Package": {
                    //                     node('rhel') {
                    //                         buildRPMPackage(OS, ARCH)
                    //                         copyRpmAndUpdateChecksums(OS, ARCH)
                    //                     }
                    //                 },
                    //                 "DEB Package": {
                    //                     node('debian') {
                    //                         buildDEBPackage(OS, ARCH)
                    //                         copyDebAndUpdateChecksums(OS, ARCH)
                    //                     }
                    //                 }
                    //             )
                    //         }
                    //     }
                    // }
                    stage("Upload artifacts") {
                        agent { label 'linux' }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                            }

                            unstash "${OS}-${ARCH}-artifacts"
                            unstash "${OS}-${ARCH}-archive-artifacts"

                            // script {
                            //     if (OS == 'linux') {
                            //         unstash "${OS}-${ARCH}-rpm-package-artifacts"
                            //         unstash "${OS}-${ARCH}-deb-package-artifacts"
                            //     }
                            // }
                            archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                        }
                        post {
                            always {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                }
            }
        }

        stage("Clean workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'linux', 'rhel', 'debian'
                    }
                }
                stages {
                    stage("Delete dist files") {
                        agent { label PLATFORM }
                        steps {
                            script {
                                sh "rm -rf ${env.DIST_PATH}/*"
                            }
                        }
                    }
                }
            }
        }
    }
}
