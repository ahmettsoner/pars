@Library('shared-lib') _

pipeline {
    agent none

    parameters {
        string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
    }
    environment {
        APPNAME      = "pars"
    }

    stages {
        stage("Prepare workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'linux', 'rhel', 'debian'
                    }
                }
                stages {
                    stage("Setup") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                setupAgent()
                            }
                        }
                    }
                    stage("Docs") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                generateDocs()
                            }
                        }
                    }
                    stage("Checksum") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                generateChecksum()
                            }
                        }
                    }
                }
            }
        }

        stage('Build Linux DEBIAN Matrix') {
            environment {
                OS      = "linux"
            }
            matrix {
                axes {
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label 'debian' } 
                        steps {
                            script {
                                buildBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Prepare Artifact and Checksum') {
                        agent { label 'debian' } 
                        steps {
                            script {
                                archiveBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Archive and Generate Metadata') {
                        agent { label 'debian' }
                        steps {
                            script {
                                packageArtifact(OS, ARCH, "tar.gz")
                            }
                        }
                    }

                    stage("Build DEB Package") {
                        agent { label 'debian' } 
                        steps {
                            script {
                                buildDEBPackage(OS, ARCH)
                                copyDebAndUpdateChecksums(OS, ARCH)
                            }
                        }
                    }

                }
            }
        }

        stage('Build Linux RHEL Matrix') {
            environment {
                OS      = "linux"
            }
            matrix {
                axes {
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label 'rhel' } 
                        steps {
                            script {
                                buildBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Prepare Artifact and Checksum') {
                        agent { label 'rhel' } 
                        steps {
                            script {
                                archiveBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Archive and Generate Metadata') {
                        agent { label 'rhel' }
                        steps {
                            script {
                                def helper = load '.pipelines/jenkins/shared-lib/vars/packageArtifact.groovy'
                                helper.packageArtifact(OS, ARCH, "tar.gz")
                            }
                        }
                    }

                    stage("Build RPM Package") {
                        agent { label 'rhel' } 
                        steps {
                            script {
                                buildRPMPackage(OS, ARCH)
                                copyRpmAndUpdateChecksums(OS, ARCH)
                            }
                        }
                    }

                }
            }
        }


        stage('Collect Artifacts') {
            agent { label 'linux' }
            steps {
                unstash 'linux-x86_64-artifacts'
                unstash 'linux-x86_64-archive-artifacts'
                unstash 'linux-x86_64-rpm-package-artifacts'
                unstash 'linux-x86_64-deb-package-artifacts'
                archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true

                sh 'rm -rf dist/*'
                echo ">>>> ${env.BUILD_VERSION}"
            }
        }
    }
}
