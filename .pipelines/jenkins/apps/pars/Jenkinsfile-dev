@Library('shared-lib') _

def osList = ['linux', 'windows']//, 'darwin', 'openbsd', 'netbsd', 'freebsd']
def archList = ['x86_64']//, 'arm64']

def targets = [
    windows: [
        x86_64: ['binary', 'binary-archive', 'msi', 'choco'],
        amd64  : ['binary', 'binary-archive', 'msi', 'choco']
    ],
    linux: [
        x86_64: ['binary', 'binary-archive', 'deb', 'rpm'],
        amd64  : ['binary', 'binary-archive', 'deb', 'rpm']
    ],
    darwin: [
        x86_64: ['binary', 'binary-archive', 'dmg', 'breq'],
        amd64  : ['binary', 'binary-archive', 'dmg', 'brew']
    ],
    openbsd: [
        x86_64: ['binary', 'binary-archive']
    ],
    netbsd: [
        x86_64: ['binary', 'binary-archive']
    ],
    freebsd: [
        x86_64: ['binary', 'binary-archive']
    ]
]
pipeline {
    agent none

    parameters {
        choice(name: 'CHANNEL', choices: ['dev', 'staging', 'prod'], description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@parsdevkit.net', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'ci-bot', description: 'Git user name')
        string(name: 'GITEA_URL', defaultValue: 'http://git.pusula.int', description: 'GITEA_URL')
        string(name: 'GITEA_BASE_URL', defaultValue: 'git.pusula.int', description: 'GITEA_URL')
        string(name: 'NEXUS_URL', defaultValue: 'http://nexus.pusula.int', description: 'NEXUS_URL')
        // string(name: 'GITEA_URL', defaultValue: 'http://192.168.118.47:3030', description: 'GITEA_URL')
        // string(name: 'GITEA_BASE_URL', defaultValue: '192.168.118.47:3030', description: 'GITEA_URL')
        // string(name: 'NEXUS_URL', defaultValue: 'http://192.168.118.47:8070', description: 'NEXUS_URL')
    }
    environment {
        APPNAME      = "pars"
        GITEA_OWNER = 'admin'
        GITEA_REPO = 'pars'
    }


    stages {
        stage("Prepare Workspace") {
            agent { label 'linux' }
            steps {
                script {
                    agentInitOnce.initOnce(params.BRANCH)
                }
                script {
                    generateDocs()
                }
            }
            post {
                cleanup {
                    script {
                        agentInitOnce.cleanupOnce()
                    }
                }
            }
        }



        stage('Build Binaries') {
            matrix {
                axes {
                    axis {
                        name 'TARGET_OS'
                        values 'linux', 'windows'//, 'darwin', 'openbsd', 'netbsd', 'freebsd'
                    }
                    axis {
                        name 'TARGET_ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                excludes {
                    exclude {
                        axis {
                            name 'TARGET_OS'
                            values 'netbsd'
                        }
                        axis {
                            name 'TARGET_ARCH'
                            values 'arm64'
                        }
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "linux" }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                            }
                            script {
                                buildBinary(TARGET_OS, TARGET_ARCH)
                                archiveBinary(TARGET_OS, TARGET_ARCH)
                                packageArtifact(TARGET_OS, TARGET_ARCH)
                            }
                        }
                        post {
                            cleanup {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                    stage("Package for Linux") {
                        when {
                            expression { return TARGET_OS == 'linux' }
                        }
                        steps {
                            script {
                                parallel(
                                    "RPM Package": {
                                        node('rhel') {
                                            agentInitOnce.initOnce(params.BRANCH)
                                            buildRPMPackage(TARGET_OS, TARGET_ARCH)
                                            copyRpmAndUpdateChecksums(TARGET_OS, TARGET_ARCH)
                                            signRpmPackage(TARGET_OS, TARGET_ARCH)
                                            agentInitOnce.cleanupOnce()
                                        }
                                    },
                                    "DEB Package": {
                                        node('debian') {
                                            agentInitOnce.initOnce(params.BRANCH)
                                            buildDEBPackage(TARGET_OS, TARGET_ARCH)
                                            copyDebAndUpdateChecksums(TARGET_OS, TARGET_ARCH)
                                            agentInitOnce.cleanupOnce()
                                        }
                                    }
                                )
                            }
                        }
                    }
                    stage("Package for Windows") {
                        when {
                            expression { return TARGET_OS == 'windows' }
                        }
                        steps {
                            script {
                                parallel(
                                    "MSI Installer": {
                                        node('windows') {
                                            agentInitOnce.initOnceWindows(params.BRANCH)
                                            buildMSIInstaller(TARGET_OS, TARGET_ARCH)
                                            copyMsiAndUpdateChecksums(TARGET_OS, TARGET_ARCH)
                                            agentInitOnce.cleanupOnceWindows()
                                        }
                                    }
                                )
                            }
                        }
                    }
                    stage("Upload artifacts") {
                        agent { label 'linux' }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                            }

                            unstash "${TARGET_OS}-${TARGET_ARCH}-artifacts"
                            unstash "${TARGET_OS}-${TARGET_ARCH}-archive-artifacts"

                            script {
                                if (TARGET_OS == 'linux') {
                                    unstash "${TARGET_OS}-${TARGET_ARCH}-rpm-package-artifacts"
                                    unstash "${TARGET_OS}-${TARGET_ARCH}-deb-package-artifacts"
                                } else if (TARGET_OS == 'windows') {
                                    unstash "${TARGET_OS}-${TARGET_ARCH}-msi-package-artifacts"
                                }
                            }
                            archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                        }
                        post {
                            cleanup {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Generate Checksums File') {
            agent { label 'linux' }
            steps {
                script {
                    agentInitOnce.initOnce(params.BRANCH)
                    generateChecksumFile()
                                    
                    osList.each { TARGET_OS ->
                        archList.each { TARGET_ARCH ->
                            if (!(TARGET_OS == 'netbsd' && TARGET_ARCH == 'arm64')) {
                                generateChecksum.WriteChecksumForBinary(TARGET_OS, TARGET_ARCH)
                                generateChecksum.WriteChecksumForArchive(TARGET_OS, TARGET_ARCH)

                                if (TARGET_OS == 'linux'){
                                    generateChecksum.WriteChecksumForDEBPackage(TARGET_ARCH)
                                    generateChecksum.WriteChecksumForRPMPackage(TARGET_ARCH)
                                } else if (TARGET_OS == 'windows'){
                                    generateChecksum.WriteChecksumForMSIInstaller(TARGET_ARCH)
                                }
                            }
                        }
                    }
                    
                    stash includes: "${env.ARTIFACT_CHECKSUM_MD5_PATH}", name: "artifacts-checksums"
                    archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                }
            }
            post {
                cleanup {
                    script {
                        agentInitOnce.cleanupOnce()
                    }
                }
            }
        }

        stage('Create Release') {
            agent { label 'linux' }
            steps {

                script {
                    agentInitOnce.initOnce(params.BRANCH)

                    releaseManagement.releaseRepo(osList, archList)
                }



            }
            post {
                cleanup {
                    script {
                        agentInitOnce.cleanupOnce()
                    }
                }
            }
        }
    }
}
