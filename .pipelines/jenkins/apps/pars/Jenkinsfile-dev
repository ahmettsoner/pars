@Library('shared-lib') _

pipeline {
    agent none

    parameters {
        string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
    }
    environment {
        APPNAME      = "pars"
    }

    stages {
        stage("Prepare workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'linux', 'rhel'//, 'debian'
                    }
                }
                stages {
                    stage("Setup") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                setupAgent()
                            }
                        }
                    }
                    stage("Docs") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                generateDocs()
                            }
                        }
                    }
                    stage("Checksum") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                generateChecksum()
                            }
                        }
                    }
                }
            }
        }

        stage('Build Linux DEBIAN Matrix') {
            environment {
                OS      = "linux"
                PLATFORM = "debian"
            }
            matrix {
                axes {
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "${PLATFORM}" } 
                        steps {
                            script {
                                buildBinary(OS, ARCH)
                            }
                        }
                    }
                    
                    // stage('Prepare Artifact and Checksum') {
                    //     agent { label "${PLATFORM}" } 
                    //     steps {
                    //         script {
                    //             archiveBinary(OS, ARCH)
                    //         }
                    //     }
                    // }
                    // stage('Archive and Generate Metadata') {
                    //     agent { label "${PLATFORM}" } 
                    //     steps {
                    //         script {
                    //             packageArtifact(OS, ARCH, "tar.gz")
                    //         }
                    //     }
                    // }

                    // stage("Build DEB Package") {
                        // agent { label "${PLATFORM}" } 
                    //     steps {
                    //         script {
                    //             buildDEBPackage(OS, ARCH)
                    //             copyDebAndUpdateChecksums(OS, ARCH)
                    //         }
                    //     }
                    // }

                }
            }
        }

        stage('Build Linux RHEL Matrix') {
            environment {
                OS      = "linux"
                PLATFORM = "rhel"
            }
            matrix {
                axes {
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "${PLATFORM}" } 
                        steps {
                            script {
                                buildBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Prepare Artifact and Checksum') {
                        agent { label "${PLATFORM}" } 
                        steps {
                            script {
                                archiveBinary(OS, ARCH)
                            }
                        }
                    }
                    stage('Archive and Generate Metadata') {
                        agent { label "${PLATFORM}" } 
                        steps {
                            script {
                                packageArtifact(OS, ARCH, "tar.gz")
                            }
                        }
                    }

                    stage("Build RPM Package") {
                        agent { label "${PLATFORM}" } 
                        steps {
                            script {
                                buildRPMPackage(OS, ARCH)
                                copyRpmAndUpdateChecksums(OS, ARCH)
                            }
                        }
                    }

                }
            }
        }

        stage('Collect Artifacts') {
            matrix {
                axes {
                    axis {
                        name 'OS'
                        values 'linux'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label 'linux' }
                        steps {
                            unstash "${OS}-${ARCH}-artifacts"
                            unstash "${OS}-${ARCH}-archive-artifacts"
                            unstash "${OS}-${ARCH}-rpm-package-artifacts"
                            // unstash "${OS}-${ARCH}-deb-package-artifacts"
                            archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                        }
                    }
                }
            }
        }

        stage("Clean workspace") {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'linux', 'rhel'//, 'debian'
                    }
                }
                stages {
                    stage("Delete dist files") {
                        agent { label "${PLATFORM}" }
                        steps {
                            script {
                                sh "rm -rf ${env.DIST_PATH}/*"
                            }
                        }
                    }
                }
            }
        }
    }
}
