@Library('shared-lib') _

pipeline {
    agent none

    parameters {
        string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
        string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
        string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
    }
    environment {
        APPNAME      = "pars"
        GITEA_URL = 'http://192.168.118.47:3030'
        GITEA_OWNER = 'admin'
        GITEA_REPO = 'pars'
    }

    stages {
        stage("Prepare Workspace") {
            parallel {
                stage("Common Operations") {
                    agent { label 'linux' }
                    steps {
                        script {
                            agentInitOnce.initOnce(params.BRANCH)
                        }
                        script {
                            generateDocs()
                        }
                    }
                    post {
                        always {
                            script {
                                agentInitOnce.cleanupOnce()
                            }
                        }
                    }
                }
            }
        }



        stage('Build Binaries') {
            matrix {
                axes {
                    axis {
                        name 'OS'
                        values 'linux'//, 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd'
                    }
                    axis {
                        name 'ARCH'
                        values 'x86_64'//, 'arm64'
                    }
                }
                excludes {
                    exclude {
                        axis {
                            name 'OS'
                            values 'netbsd'
                        }
                        axis {
                            name 'ARCH'
                            values 'arm64'
                        }
                    }
                }
                stages {
                    stage("Build Binary") {
                        agent { label "linux" }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                                buildBinary(OS, ARCH)
                                archiveBinary(OS, ARCH)
                                
                                def archExt = ""
                                if (OS == 'windows') {
                                    archExt = "zip"
                                } else {
                                    archExt = "tar.gz"
                                }
                                packageArtifact(OS, ARCH, archExt)
                            }
                        }
                        post {
                            always {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                    stage("Package for Linux") {
                        when {
                            expression { return OS == 'linux' }
                        }
                        steps {
                            script {
                                parallel(
                                    "RPM Package": {
                                        node('rhel') {
                                            agentInitOnce.initOnce(params.BRANCH)
                                            buildRPMPackage(OS, ARCH)
                                            copyRpmAndUpdateChecksums(OS, ARCH)
                                            agentInitOnce.cleanupOnce()
                                        }
                                    },
                                    "DEB Package": {
                                        node('debian') {
                                            agentInitOnce.initOnce(params.BRANCH)
                                            buildDEBPackage(OS, ARCH)
                                            copyDebAndUpdateChecksums(OS, ARCH)
                                            agentInitOnce.cleanupOnce()
                                        }
                                    }
                                )
                            }
                        }
                    }
                    stage("Upload artifacts") {
                        agent { label 'linux' }
                        steps {
                            script {
                                agentInitOnce.initOnce(params.BRANCH)
                            }

                            unstash "${OS}-${ARCH}-artifacts"
                            unstash "${OS}-${ARCH}-archive-artifacts"

                            script {
                                if (OS == 'linux') {
                                    unstash "${OS}-${ARCH}-rpm-package-artifacts"
                                    unstash "${OS}-${ARCH}-deb-package-artifacts"
                                }
                            }
                            archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                        }
                        post {
                            always {
                                script {
                                    agentInitOnce.cleanupOnce()
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Generate Checksums File') {
            agent { label 'linux' }
            steps {
                script {
                    agentInitOnce.initOnce(params.BRANCH)
                    def osList = ['linux']//, 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd']
                    def archList = ['x86_64']//, 'arm64']

                    generateChecksumFile()
                                    
                    osList.each { OS ->
                        archList.each { ARCH ->
                            if (!(OS == 'netbsd' && ARCH == 'arm64')) {
                                generateChecksum.WriteChecksumForBinary(OS, ARCH)
                                generateChecksum.WriteChecksumForArchive(OS, ARCH)

                                if (OS == 'linux'){
                                    generateChecksum.WriteChecksumForDEBPackage(ARCH)
                                    generateChecksum.WriteChecksumForRPMPackage(ARCH)
                                }
                            }
                        }
                    }
                    
                    stash includes: "${env.ARTIFACT_CHECKSUM_MD5_PATH}", name: "artifacts-checksums"
                    archiveArtifacts artifacts: 'dist/artifacts/**/*', fingerprint: true
                }
            }
            post {
                always {
                    script {
                        agentInitOnce.cleanupOnce()
                    }
                }
            }
        }

        stage('Create Gitea Release') {
            agent { label 'linux' }
            steps {

                script {
                    agentInitOnce.initOnce(params.BRANCH)

                    def osList = ['linux']//, 'windows', 'darwin', 'openbsd', 'netbsd', 'freebsd']
                    def archList = ['x86_64']//, 'arm64']

                    osList.each { OS ->
                        archList.each { ARCH ->
                            if (!(OS == 'netbsd' && ARCH == 'arm64')) {
                                unstash "${OS}-${ARCH}-artifacts"
                                unstash "${OS}-${ARCH}-archive-artifacts"
                                if (OS == 'linux') {
                                    unstash "${OS}-${ARCH}-rpm-package-artifacts"
                                    unstash "${OS}-${ARCH}-deb-package-artifacts"
                                }
                            }
                        }
                    }
                    unstash "artifacts-checksums"
                }


                script {
                    sh(
                        script: "grm changelog generate --from $env.CURRENT_BASE_VERSION-dev.1 --to $env.BUILD_VERSION --environment $env.CHANNEL --output ${env.CHANGELOG_PATH}",
                        returnStdout: true
                    ).trim()

                    def changelogText = readFile(env.CHANGELOG_PATH).trim()
                    def checksumTest = readFile(env.ARTIFACT_CHECKSUM_MD5_PATH).trim()

                    def changelog = "${changelogText}\n\n---\n\n${checksumTest}"

                    withCredentials([string(credentialsId: 'GITEA_TOKEN', variable: 'GITEA_TOKEN')]) {

                        def releaseJson = """{
                            "tag_name": "${env.BUILD_VERSION}",
                            "target": "dev",
                            "name": "${env.BUILD_VERSION} Release",
                            "body": ${groovy.json.JsonOutput.toJson(changelog)},
                            "draft": false,
                            "prerelease": false
                        }"""

                        writeFile file: 'release.json', text: releaseJson

                        sh """
                            curl -X POST "$GITEA_URL/api/v1/repos/$GITEA_OWNER/$GITEA_REPO/releases" \\
                                -H "Content-Type: application/json" \\
                                -H "Authorization: token $GITEA_TOKEN" \\
                                -d @release.json
                        """

                        def releaseInfo = sh(
                            script: """curl -s -H "Authorization: token $GITEA_TOKEN" \\
                                "$GITEA_URL/api/v1/repos/$GITEA_OWNER/$GITEA_REPO/releases/tags/${env.BUILD_VERSION}" """,
                            returnStdout: true
                        ).trim()

                        // ⚠️ JsonSlurperClassic yerine JsonSlurper kullanılıyor
                        def releaseId = new groovy.json.JsonSlurper().parseText(releaseInfo).id

                        // artifacts klasöründeki tüm dosyaları bul ve yükle
                        def fileList = sh(
                            script: "find ${env.ARTIFACT_PATH} -type f",
                            returnStdout: true
                        ).trim().split('\n')
                        fileList.each { filePath ->
                            def fileName = filePath.tokenize('/').last()
                            echo "Uploading artifact: ${fileName}"
                            sh """
                                curl -X POST "$GITEA_URL/api/v1/repos/$GITEA_OWNER/$GITEA_REPO/releases/$releaseId/assets?name=${fileName}" \\
                                    -H "Authorization: token $GITEA_TOKEN" \\
                                    -H "Content-Type: application/octet-stream" \\
                                    --data-binary @${filePath}
                            """
                        }                    }
                }

            }
            post {
                always {
                    script {
                        agentInitOnce.cleanupOnce()
                    }
                }
            }
        }
    }
}
