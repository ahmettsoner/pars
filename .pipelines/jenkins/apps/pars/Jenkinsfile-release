@Library('shared-lib') _

pipeline {
  agent none

  parameters {
      string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
      string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
      string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
      string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
  }
  
  environment {
    GITEA_OWNER = 'admin'
    GITEA_REPO = 'pars'
  }

  stages {
    stage('Create Gitea Release') {
      agent { label 'linux' }
      steps {
        script {
            agentInitOnce.initOnce(params.BRANCH)
        }

        script {

          withCredentials([string(credentialsId: 'GITEA_TOKEN', variable: 'GITEA_TOKEN')]) {
            sh """
              curl -X POST "$</api/v1/repos/$GITEA_OWNER/$GITEA_REPO/releases" \\
                -H "Content-Type: application/json" \\
                -H "Authorization: token $GITEA_TOKEN" \\
                -d '{
                  "tag_name": "$env.CURRENT_VERSION",
                  "target": "$params.BRANCH",
                  "name": "$env.CURRENT_VERSION Release",
                  "body": "test",
                  "draft": false,
                  "prerelease": false
                }'
            """
          }
        }
      }
      post {
          always {
              script {
                  agentInitOnce.cleanupOnce()
              }
          }
      }
    }
  }
}
