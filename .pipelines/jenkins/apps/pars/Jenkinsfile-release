@Library('shared-lib') _

pipeline {
  agent none

  parameters {
      string(name: 'CHANNEL', defaultValue: 'dev', description: 'Release channel (e.g., dev, prod)')
      string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to checkout')
      string(name: 'GIT_USER_EMAIL', defaultValue: 'ci@example.com', description: 'Git user email')
      string(name: 'GIT_USER_NAME', defaultValue: 'CI Bot', description: 'Git user name')
  }
  
  environment {
    GITEA_URL = 'http://192.168.118.47:3030'
    GITEA_OWNER = 'admin'
    GITEA_REPO = 'pars'
    BUILD_VERSION = "v1.0.0-dev.1"
  }

  stages {
    stage('Create Gitea Release') {
      agent { label 'linux' }
      steps {
        // script {
        //     agentInitOnce.initOnce(params.BRANCH)
        // }

        // def releaseChangelogContent = sh(
        //   script: "grm changelog generate --from $env.CURRENT_BASE_VERSION-dev.1 --to $env.BUILD_VERSION --environment dev --output ${env.CHANGES_PATH}/${env.BUILD_VERSION}.md",
        //   returnStdout: true
        // ).trim()
          
        def changelog = '''## Değişiklikler

      - Yeni özellik: X modülü eklendi
      - Hata düzeltme: Y hatası giderildi
      - Performans iyileştirmeleri'''.replaceAll('"', '\\"').replaceAll('\n', '\\n')

        withCredentials([string(credentialsId: 'GITEA_TOKEN', variable: 'GITEA_TOKEN')]) {
          sh """
            curl -X POST "$GITEA_URL/api/v1/repos/$GITEA_OWNER/$GITEA_REPO/releases" \\
              -H "Content-Type: application/json" \\
              -H "Authorization: token $GITEA_TOKEN" \\
              -d '{
                "tag_name": "$BUILD_VERSION",
                "target": "main",
                "title": "$BUILD_VERSION Release",
                "note": "${changelog}",
                "draft": false,
                "prerelease": false
              }'
          """
        }
      }
      // post {
      //     always {
      //         script {
      //             agentInitOnce.cleanupOnce()
      //         }
      //     }
      // }
    }
  }
}
