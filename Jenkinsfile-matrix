pipeline {
    agent none
    stages {
        stage("parallel"){
            parallel {
                stage('Test') {
                    matrix {
                        axes {
                            axis {
                                name 'OS'
                                values 'linux', 'windows'
                            }
                            axis {
                                name 'JAVA'
                                values '8', '11'
                            }
                        }
                        agent { label 'rhel' } 
                        stages {
                            stage('Run tests') {
                                steps {
                                    echo "Running tests on ${OS} with Java ${JAVA}"
                                }
                            }
                        }
                    }
                }
                stage('dev') {
                    matrix {
                        axes {
                            axis {
                                name 'OS'
                                values 'linux', 'windows'
                            }
                            axis {
                                name 'JAVA'
                                values '8', '11'
                            }
                        }
                        agent { label 'rhel' } 
                        stages {
                            stage('Run tests') {
                                steps {
                                    echo "Running tests on ${OS} with Java ${JAVA}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
