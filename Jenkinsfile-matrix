pipeline {
    agent none
    stages {
        stage('Linux Tests') {
            parallel {
                stage('Linux - Java 8') {
                    agent { label 'rhel' } 
                    steps {
                        echo 'Running on Linux with Java 8'
                    }
                }
                stage('Linux - Java 11') {
                    agent { label 'rhel' } 
                    steps {
                        echo 'Running on Linux with Java 11'
                    }
                }
            }
        }
        stage('Windows Tests') {
            parallel {
                stage('Windows - Java 8') {
                    agent { label 'rhel' } 
                    steps {
                        echo 'Running on Windows with Java 8'
                    }
                }
                stage('Windows - Java 11') {
                    agent { label 'rhel' } 
                    steps {
                        echo 'Running on Windows with Java 11'
                    }
                }
            }
        }
    }
}
