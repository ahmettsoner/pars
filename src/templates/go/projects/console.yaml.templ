Type: Project
Kind: Application
Name:  {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: 
    Name: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}
  
  Platform: 
    Type: go
    Version: {{ .PlatformVersion }}



  Layers:
    - Name: presentation:controller
      Path: Controllers

  Dependencies:
  References:
Application:
  ProjectType: Console
  Runtime:
    Type: go
    Version: {{ .RuntimeVersion }}
  Options: