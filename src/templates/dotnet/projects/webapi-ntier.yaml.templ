Type: Project
Kind: Application
Name:  {{ .Name }}.Core
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}.Core
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Core
  Path: {{ .Path }}.Core

  Platform: 
    Type: dotnet
    Version: {{ .PlatformVersion }}



  Layers:
    - Name: core
      Path: Core

  Dependencies:
  References:

Application:
  ProjectType: Library
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options:

---
Type: Project
Kind: Application
Name:  {{ .Name }}.Database
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}.Database
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Database
  Path: {{ .Path }}.Database

  Platform: 
    Type: dotnet
    Version: {{ .PlatformVersion }}



  Layers:
    - Name: persistence:database:entity
      Path: Database/Entities
    - Name: persistence:database:repository
      Path: Database/Repositories

  Dependencies:
Application:
  ProjectType: Library
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options:


---
Type: Project
Kind: Application
Name:  {{ .Name }}.Service
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}.Service
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Service
  Path: {{ .Path }}.Service

  Platform: 
    Type: dotnet
    Version: {{ .PlatformVersion }}



  Layers:
    - Name: service
      Path: Services
    - Name: business:model
      Path: Models

  Dependencies:
  References:
  - Name: {{ .Name }}.Core
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
  - Name: {{ .Name }}.Database
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
Application:
  ProjectType: Library
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options:

---
Type: Project
Kind: Application
Name:  {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}
  
  Platform: 
    Type: dotnet
    Version: {{ .PlatformVersion }}



  Layers:
    - Name: presentation:controller
      Path: Controllers

  Dependencies:
  References:
  - Name: {{ .Name }}.Core
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
  - Name: {{ .Name }}.Database
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
  - Name: {{ .Name }}.Service
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
Application:
  ProjectType: WebApi
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options: