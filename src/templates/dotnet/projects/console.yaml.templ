Type: Project
Kind: Application
Name:  {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}
  
  Platform: 
    Type: dotnet
    Version: {{ .PlatformVersion }}


  Layers:
    - Name: presentation:controller
      Path: Controllers

  Dependencies:
  References:
Application:
  ProjectType: Console
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options: