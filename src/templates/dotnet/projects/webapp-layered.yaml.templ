Type: Project
Kind: Application
Name:  {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}
  
  Platform: 
    Type: dotnet
    Version: Net7



  Layers:
    - Name: core
      Path: Core
    - Name: service
      Path: Services
    - Name: business:model
      Path: Models
    - Name: persistence:database:entity
      Path: Database/Entities
    - Name: persistence:database:repository
      Path: Database/Repositories
    - Name: presentation:controller
      Path: Controllers
    - Name: presentation:view
      Path: Views

  Dependencies:
  References:


Application:
  ProjectType: WebApp
  Runtime:
    Type: dotnet
    Version: {{ .RuntimeVersion }}
  Options:
