Type: Project
Kind: Application
Name: {{ .Name }}.Core
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}.Core
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Core
  Path: {{ .Path }}.Core

  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}


  Layers:
  - core
  
  Dependencies:
  References:
Application:
  ProjectType: Library
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options:



---
Type: Project
Kind: Application
Name: {{ .Name }}.Service
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}.Service
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Service
  Path: {{ .Path }}.Service

  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}



  Layers:
  - service
  - business:model

  Dependencies:
  References:
  - Name: {{ .Name }}.Core
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
Application:
  ProjectType: Library
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options:

---
Type: Project
Kind: Application
Name: {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}
  
  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}


  Layers:
    - presentation:controller
    - presentation:view

  Dependencies:
  References:
  - Name: {{ .Name }}.Core
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
  - Name: {{ .Name }}.Service
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
Application:
  ProjectType: SPA
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options: