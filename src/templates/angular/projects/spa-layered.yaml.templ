Type: Project
Kind: Application
Name: {{ .Name }}
Metadata:
  Tags:
Specifications:
  Name: {{ .Name }}
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}
  Path: {{ .Path }}

  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}


  Layers:
    - core
    - service
    - business:model
    - persistence:database:entity
    - persistence:database:repository
    - presentation:controller
    - presentation:view
  Options:

  Dependencies:
  References:


Application:
  ProjectType: SPA
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options: