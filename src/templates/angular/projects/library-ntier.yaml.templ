Type: Project
Kind: Application
Name: {{ .Name }}.Core
Metadata:
  Tags:
Specifications::
  Name: {{ .Name }}.Core
  Workspace: {{ .Workspace }}
  Group: {{ .Group }}
  Set: {{ .Set }}
  Package: {{ .Package }}.Core
  Path: {{ .Path }}.Core
  
  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}


  Layers:
  - core

  Dependencies:
  References:
Application:
  ProjectType: Library
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options:


---
Type: Project
Kind: Application
Name: {{ .Name }}.Service
Metadata:
  Tags:
Specifications::
  Platform: 
    Type: angular
    Version: {{ .PlatformVersion }}

    Name: {{ .Name }}.Service
    Workspace: {{ .Workspace }}
    Group: {{ .Group }}
    Set: {{ .Set }}
    Package: {{ .Package }}.Service
    Path: {{ .Path }}.Service


  Layers:
  - service
  - business:model

  Dependencies:
  References:
  - Name: {{ .Name }}.Core
    Group:  {{ .Group }}
    Workspace: {{ .Workspace }}
Application:
  ProjectType: Library
  Runtime:
    Type: nodejs
    Version: {{ .RuntimeVersion }}
  Options:
