          "attributes": {
            "filename": null,
            "id": "a701aa782a2040bff16acefba50e48570ebc3eb68a3264a9816c528cced7cf68",
            "rendered": "#cloud-config\nhostname: haproxy-vm\nusers:\n  - name: ahmetsoner\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    groups: wheel\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-rsa  your_email@example.com\n\n\nwrite_files:\n  - path: /etc/netplan/01-netcfg.yaml\n    content: |\n      network:\n        version: 2\n        ethernets:\n          eth0:\n            addresses:\n              - 192.168.124.100/24\n            gateway4: 192.168.124.1\n            nameservers:\n              addresses: [8.8.8.8, 1.1.1.1]\nruncmd:\n  - netplan apply\n",
            "template": "#cloud-config\nhostname: ${hostname}\nusers:\n  - name: ${username}\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    groups: wheel\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ${ssh_authorized_key}\n\nwrite_files:\n  - path: /etc/netplan/01-netcfg.yaml\n    content: |\n      network:\n        version: 2\n        ethernets:\n          eth0:\n            addresses:\n              - 192.168.124.100/24\n            gateway4: 192.168.124.1\n            nameservers:\n              addresses: [8.8.8.8, 1.1.1.1]\nruncmd:\n  - netplan apply\n",
            "vars": {
              "hostname": "haproxy-vm",
              "ssh_authorized_key": "ssh-rsa  your_email@example.com\n",
              "username": "ahmetsoner"
            }
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
